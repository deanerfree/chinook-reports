<header class="fixed top-0 inset-x-0 z-20 bg-linear-to-r from-header-from to-header-to text-white py-3 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between py-3 text-sm">
    <div class="flex items-center gap-6">
      <a href="/">
        <img
          alt="Chinook Consulting"
          width="150"
          src="https://chinookpetroleum.com/wp-content/uploads/2018/01/logo.png"
        />
      </a>

      <div>
        <%= if report = assigns[:report] do %>
          <div class="flex flex-col items-start text-center text-xs leading-tight">
            <span class="font-bold text-sm">{report.well_name}</span>
            <span class="opacity-75">{report.unique_well_id} · {report.operator}</span>
          </div>
        <% end %>
      </div>
    </div>
    <div class="flex items-center gap-4">
      <button type="button" class="btn-primary" phx-click={show_modal("new-report-modal")}>
        + New Report
      </button>
    </div>
  </div>
</header>

<.modal id="new-report-modal">
  <h2 class="text-lg font-bold text-copy mb-1">Draft New Well Report</h2>
  <p class="text-xs text-copy-secondary mb-6">Enter the well information to get started.</p>

  <.form
    for={@new_report_form}
    phx-change="validate_new_report"
    phx-submit="create_new_report"
    class="space-y-4"
  >
    <.field
      field={@new_report_form[:well_name]}
      label="Well Name *"
      placeholder="e.g. GEAR SODA LAKE 103 HZ"
    />
    <.field
      field={@new_report_form[:unique_well_id]}
      label="UWI *"
      placeholder="e.g. XXX/XX-XX-XXX-XXWX/XX"
    />
    <.field
      field={@new_report_form[:operator]}
      label="Operator"
      placeholder="e.g. Chinook Petroleum Ltd."
    />

    <div class="flex justify-end gap-3 pt-4 border-t border-border-light">
      <button type="button" class="btn-secondary" phx-click={hide_modal("new-report-modal")}>
        Cancel
      </button>
      <button type="submit" class="btn-primary">
        Continue →
      </button>
    </div>
  </.form>
</.modal>
<div class="flex flex-row mt-22.5 h-[calc(100vh-90px)]">
  <.nav_sidebar
    current_page={assigns[:current_page] || "/"}
    reports={assigns[:reports] || []}
  />
  <main class="flex-1 min-w-0 overflow-y-auto p-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
