<header class="fixed top-0 inset-x-0 z-20 bg-linear-to-r from-header-from to-header-to text-white py-3 px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img
          alt="Chinook Consulting"
          width="150"
          src="https://chinookpetroleum.com/wp-content/uploads/2018/01/logo.png"
        />
      </a>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 btn-primary">
      <a href="https://chinookpetroleum.com" target="_blank" rel="noopener noreferrer">
        Return to Chinook Homepage
      </a>
    </div>
  </div>
</header>
<div class="flex flex-row mt-22.5 h-[calc(100vh-90px)]">
  <.nav_sidebar
    current_page={assigns[:current_page] || "/"}
    reports={assigns[:reports] || []}
  />
  <main class="flex-1 min-w-0 overflow-y-auto p-8">
    <.flash_group flash={@flash} />
    {@inner_content}
  </main>
</div>
