<header class="app-header px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img 
          alt="Chinook Consulting"
          width="150" 
          src="https://chinookpetroleum.com/wp-content/uploads/2018/01/logo.png" />
      </a>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 btn-primary">
      <a href="https://chinookpetroleum.com" target="_blank" rel="noopener noreferrer">
        Return to Chinook Homepage
      </a>
    </div>
  </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>
