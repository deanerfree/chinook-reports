<!DOCTYPE html>
<html lang="en" class="[scrollbar-gutter:stable] h-full">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="ChinookReports" suffix=" · Phoenix Framework">
      {assigns[:page_title]}
    </.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/app.css"} />
    <link rel="icon" type="image/png" href={~p"/images/favicon.png"}>
    <script>
      if (localStorage.getItem("sidebar-collapsed") === "true") {
        document.documentElement.dataset.sidebarCollapsed = "true";
      }
    </script>
    <script src={~p"/assets/topbar.js"}>
    </script>
    <script defer phx-track-static type="module" src={~p"/assets/app.js"}>
    </script>
  </head>
  <body class="">
    {@inner_content}
  </body>
</html>
